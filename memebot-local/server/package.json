{
  "name": "@memebot/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/migrations.sql','dist/db/migrations.sql')\"",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wallet:generate": "tsx src/scripts/generateWallet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^13.0.2",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.4",
    "fastify": "^5.11.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
