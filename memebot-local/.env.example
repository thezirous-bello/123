# MemeBot Local — environment configuration
# Copy this file to .env and fill in what you need. See README.md for full setup instructions.
# NEVER commit your real .env file. It is already excluded via .gitignore.

# ============================================================
# APPLICATION (all optional, sensible defaults shown)
# ============================================================

# Port the dashboard API server listens on.
PORT=3000

# Starting trading mode. "paper" is the only safe default — do not change this
# to force live trading; use LIVE_TRADING_ENABLED below instead, deliberately.
DEFAULT_TRADING_MODE=paper

# ============================================================
# SOLANA (SOLANA_RPC_URL required, everything else optional)
# ============================================================

# REQUIRED. Your Solana RPC endpoint.
# The default below is Solana's public mainnet RPC — it works but is rate-limited
# and unsuitable for frequent token scanning. For real use, get a free RPC URL
# from Helius (https://www.helius.dev) and paste the full URL here.
# Safe for: server-only (never expose to a browser).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# OPTIONAL. The dedicated LOCAL TRADING WALLET private key. This must NEVER be
# your main Phantom/Trust Wallet seed phrase or key — only a separate wallet
# you fund with a small, disposable trading balance.
# Leave this blank and run `npm run wallet:generate -w server` instead — that
# command creates a wallet for you and writes the key directly into this .env
# file, without ever printing it to your terminal or any log.
# Accepts either a base58-encoded secret key (e.g. exported from Phantom) or a
# JSON array of numbers (e.g. produced by `solana-keygen new`).
# Safe for: server-only. NEVER put this in frontend code or source control.
SOLANA_PRIVATE_KEY=

# ============================================================
# JUPITER (optional — has a working default)
# ============================================================

# Jupiter Swap API base URL used for quotes and swap transactions.
# Default is Jupiter's free "Lite" API tier (no API key required, rate-limited).
# If you have a Jupiter API key for the paid tier, you can point this at
# https://api.jup.ag/swap/v1 instead and set JUPITER_API_KEY below.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# OPTIONAL. Only used if you switch JUPITER_API_URL to the paid api.jup.ag host.
# Get one at https://portal.jup.ag
# Safe for: server-only.
JUPITER_API_KEY=

# ============================================================
# MARKET DATA (optional — DexScreener requires no key)
# ============================================================

# DexScreener is the default, free, no-key-required market data source.
DEXSCREENER_API_URL=https://api.dexscreener.com

# OPTIONAL. Helius API key. Used only as a fallback for richer token metadata
# (name/symbol/image) when DexScreener doesn't have it, via Helius's DAS API.
# Get a free key at https://www.helius.dev
# Safe for: server-only.
HELIUS_API_KEY=

# OPTIONAL. Birdeye API key. Used only as a fallback token-overview data source
# when DexScreener has no data for a token. Get one at https://birdeye.so
# Safe for: server-only.
BIRDEYE_API_KEY=

# ============================================================
# AI-ASSISTED STRATEGY PARSING (fully optional)
# ============================================================

# OPTIONAL. If unset, MemeBot Local parses your natural-language strategy with
# its built-in local rule parser — no AI or network call required. If set, the
# app additionally uses Claude to help interpret strategies it can't parse
# confidently on its own. The AI never places trades; its only output is a
# structured strategy object, which is still validated and shown to you before
# activation exactly like the local parser's output.
# Get a key at https://console.anthropic.com
# Safe for: server-only.
ANTHROPIC_API_KEY=

# Model used for AI-assisted parsing, if ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================================
# SAFETY / LIVE TRADING (do not change lightly)
# ============================================================

# Must be the literal string "true" to allow live trading at all. Any other
# value (including missing) keeps the bot paper-trading-only, even if you
# request live mode from the dashboard.
LIVE_TRADING_ENABLED=false
