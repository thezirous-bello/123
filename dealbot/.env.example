# ---- Dashboard --------------------------------------------------------
PORT=4000

# Private admin dashboard login. Change these before running for real —
# there is no self-registration, this is a single-operator private tool.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# Random long string used to sign the dashboard session cookie. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Bot behavior -------------------------------------------------------
# "demo" uses the built-in demo product source (clearly-labeled sample
# data, never posted as if it were real). "production" only ever uses
# real connected sources below — if none are configured, production mode
# simply finds nothing, it does not fall back to demo data.
DEALBOT_MODE=demo

SCAN_INTERVAL_MINUTES=10

# ---- Telegram -----------------------------------------------------------
# Create a bot for free via @BotFather on Telegram — no approval needed.
# Leave blank to keep Telegram posting disabled (the bot still scans/scores,
# it just never posts).
TELEGRAM_BOT_TOKEN=

# ---- Affiliate: generic tag-based provider -------------------------------
# The simplest real affiliate mechanism: appending your tracking
# tag/id to outbound links (this is how Amazon Associates and many
# others work). Configure real per-source affiliate tags from the
# dashboard's Sources panel once you connect a source — these env vars
# are only a fallback default.
DEFAULT_AFFILIATE_TAG=

# ---- Notifications --------------------------------------------------------
# Chat ID (your own, or an admin group) the bot DMs for operational alerts
# (bot stopped, API failing, exceptional deal, etc). Get your chat id by
# messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_CHAT_ID=
